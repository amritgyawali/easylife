{
  "expo": {
    "name": "Amrit LifeOS",
    "slug": "amrit-lifeos",
    "scheme": "amritlifeos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amritlifeos.app"
    },
    "android": {
      "package": "com.amritlifeos.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "name": "Amrit LifeOS",
      "shortName": "LifeOS",
      "description": "Personal life and finance management — tasks, habits, notes, and a full ledger, offline-first.",
      "lang": "en",
      "themeColor": "#0B5FFF",
      "backgroundColor": "#F8F9FB",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Amrit LifeOS to use Face ID to unlock the app."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Amrit LifeOS to use Face ID to unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0B5FFF"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-font"
    ]
  }
}
